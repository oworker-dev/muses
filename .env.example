OWORKER_WEB_PORT=3000
OWORKER_API_PORT=3001
OWORKER_DB_PORT=5432
OWORKER_WORKFLOW_DB_PORT=5433
OWORKER_CACHE_PORT=6379
OWORKER_STORAGE_PORT=9000
OWORKER_STORAGE_CONSOLE_PORT=9001

APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_PUBLIC_URL=http://localhost:3001
SAAS_API_BASE_URL=http://localhost:3001
ANSS_WEB_BASE_URL=http://localhost:3000
ANSS_API_BASE_URL=http://localhost:3001
DEFAULT_LOCALE=en

DATABASE_URL=postgresql://oworker:oworker@localhost:5432/oworker_saas
REDIS_URL=redis://localhost:6379
WORKFLOW_TARGET_WORLD=@workflow/world-postgres
WORKFLOW_POSTGRES_URL=postgresql://oworker:oworker@localhost:5433/muses_workflow_world
WORKFLOW_POSTGRES_JOB_PREFIX=muses_

BETTER_AUTH_SECRET=oworker-saas-starter-dev-secret-change-before-production
SITE_ADMIN_EMAILS=

GITHUB_AUTH_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MUSES_WORKFLOW_HARNESS_ENABLED=false
MUSES_INITIAL_CREDIT_MICROS=100000000
# Base64-encoded 32-byte key used only by the server-side Provider Credential
# Vault. Keep this stable across restarts and set an explicit rotation id.
MUSES_CREDENTIAL_MASTER_KEY=
MUSES_CREDENTIAL_MASTER_KEY_ID=primary-v1
# Exact comma-separated hosts allowed for Admin-managed custom Provider URLs in
# production. Official OpenAI is allowed by default.
MUSES_PROVIDER_ALLOWED_HOSTS=api.openai.com
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Optional independent image route. When OPENAI_IMAGE_BASE_URL is set,
# OPENAI_IMAGE_API_KEY is required so a shared key is never forwarded.
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_BASE_URL=

# Standalone Open Agent Host integration. The service URL is server-to-server;
# the public URL is used by the embedded browser projection. JWT settings must
# match the standalone Agent deployment.
MUSES_AGENT_SERVICE_URL=
MUSES_AGENT_PUBLIC_URL=
MUSES_AGENT_HOST_JWT_SECRET=
MUSES_AGENT_HOST_JWT_ISSUER=muses-host
MUSES_AGENT_HOST_JWT_AUDIENCE=muses-agent
MUSES_AGENT_HOST_JWT_TTL_SECONDS=300
# Optional credential-free runtime catalog. When omitted, Muses resolves
# published active LLM offerings with an active Provider Credential Vault entry.
MUSES_AGENT_RUNTIME_CONFIG_JSON=
MUSES_AGENT_MODELS_JSON=
MUSES_AGENT_DEFAULT_MODEL_ID=
# HMAC secret for the standalone Agent Host capability bridge.
MUSES_AGENT_HOST_TOOLS_SECRET=
# The Provider broker keeps Admin-managed LLM credentials inside Muses and
# exposes only a private Responses-compatible API to the standalone Agent.
MUSES_AGENT_PROVIDER_BROKER_SECRET=
MUSES_AGENT_PROVIDER_TIMEOUT_MS=120000

# Standard OpenTelemetry export shared with the standalone Agent deployment.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1

STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STARTER=
STRIPE_WEBHOOK_SECRET=

S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=oworker-saas
S3_ACCESS_KEY_ID=oworker
S3_SECRET_ACCESS_KEY=oworker-local-minio-secret

EMAIL_PROVIDER=local-test
RESEND_API_KEY=
RESEND_FROM=
